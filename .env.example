# Copy to .env and fill in. Every variable is optional except an AI key for chat.

# ---- Chat model (OpenAI or any OpenAI-compatible API: Groq, OpenRouter, LM Studio, vLLM; or Ollama)
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# For Ollama on the host: AI_PROVIDER=ollama, AI_BASE_URL=http://host.docker.internal:11434, AI_MODEL=llama3.1

# ---- Embeddings (defaults to the chat provider's URL and key)
# openai | ollama | hash (offline, lexical only, demo use) | none
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Must match the model's output size. Changing it later requires a fresh database.
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# ---- Live web search: tavily | brave | searxng | none
SEARCH_PROVIDER=none
SEARCH_API_KEY=
# Only for searxng, e.g. http://searxng:8080
SEARCH_BASE_URL=

# ---- Accounts
# Comma-separated emails that become administrators when they register.
ADMIN_EMAILS=
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_PORT=3000
# Set to true when served over HTTPS.
SESSION_COOKIE_SECURE=false

# ---- Database
DATABASE_USERNAME=agentic
DATABASE_PASSWORD=change-me

# ---- Password-reset email (optional; without SMTP the "forgot password" feature is disabled)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@agentic-rag.local

# ---- Limits (per user per minute)
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
